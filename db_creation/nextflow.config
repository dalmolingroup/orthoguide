params {
    download_references = false
    species_list      = "${baseDir}/data/final_species_list.txt"
    clade_names_dir   = "${baseDir}/data/clade_names/"
    string_eukaryotes = "${baseDir}/data/string_eukaryotes.rda"
    geneplast_data    = "${baseDir}/data/gpdata_string_v11.RData"
    cogdata_table     = "${baseDir}/data/COG.mappings.v11.0.txt.gz"
    protein_info      = "${baseDir}/data/protein.info.v11.0.txt.gz"

    outdir            = "../orthoguide_front/public/"
}

process {
    cpus = 2
    memory = '4.GB'

    errorStrategy = 'retry'
    maxRetries = 2

    withName: GENEBRIDGE {
        memory = '16.GB'
        publishDir.enabled = false
    }

    withName: DB_CREATION {
        publishDir = [
            path: "${params.outdir}",
            mode: 'copy',
            saveAs: { filename -> "orthoguide_data.db.gz" }
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled = true
        docker.enabled = false
    }
}
